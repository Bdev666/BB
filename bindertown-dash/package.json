{
  "name": "bindertown-dash",
  "productName": "BinderDash",
  "version": "1.6.42",
  "description": "Fan-made multi-account launcher and dashboard for Binder Town (unofficial)",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "check": "node tools/check-syntax.js && node tools/check-page-scripts.js && node tools/session-data.test.js && node tools/features.test.js && node src/game-adapter.test.js",
    "dist": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac --universal"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.fanmade.binderdash",
    "productName": "BinderDash",
    "files": [
      "src/**/*",
      "package.json",
      "!node_modules/msgpackr-extract/**",
      "!node_modules/@msgpackr-extract/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "artifactName": "BinderDash-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "npmRebuild": false,
    "publish": [
      {
        "provider": "github",
        "owner": "Bdev666",
        "repo": "BB",
        "releaseType": "release"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.games",
      "identity": null,
      "hardenedRuntime": false
    },
    "dmg": {
      "artifactName": "BinderDash-${version}-mac.${ext}",
      "title": "BinderDash ${version}"
    },
    "afterPack": "build/adhoc-sign.js"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "msgpackr": "^1.11.2"
  }
}
